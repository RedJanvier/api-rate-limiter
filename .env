# ---- Service ports (host) ----
GATEWAY_PORT=8081
SMS_PORT=8082
EMAIL_PORT=8083

# ---- Postgres ----
POSTGRES_DB=notifications
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- SMS provider: mock | twilio ----
SMS_PROVIDER=mock
# Required only when SMS_PROVIDER=twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---- Email / SMTP ----
# Defaults target the Mailpit container (see docker-compose.yml).
EMAIL_FROM=no-reply@rate-limiter.local
